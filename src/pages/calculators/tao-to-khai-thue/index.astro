  const docCNKD = document.getElementById('document_content_cnkd');
  const docQTTNCN = document.getElementById('document_content_qttncn');
  const docGTGT = document.getElementById('document_content_gtgt');

  // Inputs
  const cnkdName = document.getElementById('cnkd_name');
  const cnkdMst = document.getElementById('cnkd_mst');
  const cnkdRevRetail = document.getElementById('cnkd_rev_retail');
  const cnkdRevService = document.getElementById('cnkd_rev_service');
  const cnkdRevProduce = document.getElementById('cnkd_rev_produce');
  const cnkdRevOther = document.getElementById('cnkd_rev_other');
  const cnkdVatReduction = document.getElementById('cnkd_vat_reduction');

  const qttncnName = document.getElementById('qttncn_name');
  const qttncnMst = document.getElementById('qttncn_mst');
  const qttncnIncome = document.getElementById('qttncn_income');
  const qttncnDependents = document.getElementById('qttncn_dependents');
  const qttncnInsurance = document.getElementById('qttncn_insurance');
  const qttncnDeducted = document.getElementById('qttncn_deducted');

  const gtgtName = document.getElementById('gtgt_name');
  const gtgtMst = document.getElementById('gtgt_mst');
  const gtgtRevRetail = document.getElementById('gtgt_rev_retail');
  const gtgtRevService = document.getElementById('gtgt_rev_service');
  const gtgtRevProduce = document.getElementById('gtgt_rev_produce');
  const gtgtVatReduction = document.getElementById('gtgt_vat_reduction');

  // Output action buttons
  const btnExportXML = document.getElementById('btnExportXML');
  const btnExportExcel = document.getElementById('btnExportExcel');
  const btnExportWord = document.getElementById('btnExportWord');
  const btnPrintPDF = document.getElementById('btnPrintPDF');

  // Format currency helper
  function formatMoney(num) {
    return Math.round(num).toLocaleString('vi-VN');
  }

  // Handle period change options
  taxPeriod?.addEventListener('change', (e) => {
    const period = e.target.value;
    taxPeriodVal.innerHTML = '';
    
    if (period === 'quarter') {
      periodDetailLabel.textContent = 'Chọn Quý';
      taxPeriodVal.innerHTML = `
        <option value="Q1">Quý I</option>
        <option value="Q2">Quý II</option>
        <option value="Q3">Quý III</option>
        <option value="Q4">Quý IV</option>
      `;
    } else {
      periodDetailLabel.textContent = 'Chọn Tháng';
      for (let m = 1; m <= 12; m++) {
        taxPeriodVal.innerHTML += `<option value="M${m}">Tháng ${m}</option>`;
      }
    }
    calculateAll();
  });

  // Handle subject change layout
  taxSubject?.addEventListener('change', (e) => {
    const subject = e.target.value;

    // Toggle input sections
    subjectCNKD.classList.add('hidden');
    subjectQTTNCN.classList.add('hidden');
    subjectGTGT.classList.add('hidden');

    // Toggle preview sections
    docCNKD.classList.add('hidden');
    docQTTNCN.classList.add('hidden');
    docGTGT.classList.add('hidden');

    if (subject === 'cnkd') {
      subjectCNKD.classList.remove('hidden');
      docCNKD.classList.remove('hidden');
      taxPeriod.disabled = false;
      taxPeriodVal.disabled = false;
    } else if (subject === 'qttncn') {
      subjectQTTNCN.classList.remove('hidden');
      docQTTNCN.classList.remove('hidden');
      // For personal income tax finalization, it's always annual (Yearly)
      taxPeriod.disabled = true;
      taxPeriodVal.disabled = true;
    } else if (subject === 'gtgt') {
      subjectGTGT.classList.remove('hidden');
      docGTGT.classList.remove('hidden');
      taxPeriod.disabled = false;
      taxPeriodVal.disabled = false;
    }
    calculateAll();
  });

  // Periodic inputs calculations
  function calculateAll() {
    const subject = taxSubject.value;
    const periodType = taxPeriod.value;
    const periodVal = taxPeriodVal.value;
    const year = taxYear.value || '2026';

    let timeTitle = '';
    if (subject === 'qttncn') {
      timeTitle = `Năm ${year}`;
    } else {
      const timeName = periodType === 'quarter' 
        ? (periodVal === 'Q1' ? 'Quý I' : periodVal === 'Q2' ? 'Quý II' : periodVal === 'Q3' ? 'Quý III' : 'Quý IV')
        : `Tháng ${periodVal.replace('M', '')}`;
      timeTitle = `${timeName}/${year}`;
    }

    // Set time titles in doc views
    document.querySelectorAll('.tax-period-title').forEach(el => el.textContent = timeTitle);
    document.querySelectorAll('.tax-year-title').forEach(el => el.textContent = year);

    if (subject === 'cnkd') {
      // 1. HKD Calculations
      const name = cnkdName.value || 'Nguyễn Văn A';
      const mst = cnkdMst.value || '8012345678';
      document.querySelectorAll('.lbl_name').forEach(el => el.textContent = name);
      document.querySelectorAll('.lbl_mst').forEach(el => el.textContent = mst);

      const rRetail = parseFloat(cnkdRevRetail.value) || 0;
      const rService = parseFloat(cnkdRevService.value) || 0;
      const rProduce = parseFloat(cnkdRevProduce.value) || 0;
      const rOther = parseFloat(cnkdRevOther.value) || 0;

      // VAT rates with potential 2% reduction (reduced to 20% of tax rate)
      const reductionActive = cnkdVatReduction.value === 'detect';
      const rateVatRetail = reductionActive ? 0.008 : 0.01; // 1% -> 0.8%
      const rateVatService = 0.05; // Services are usually not reduced or direct reduction depends, let's keep services at 5%
      const rateVatProduce = reductionActive ? 0.024 : 0.03; // 3% -> 2.4%
      const rateVatOther = reductionActive ? 0.016 : 0.02; // 2% -> 1.6%

      // Display tax rates
      document.getElementById('td_rate_gtgt_retail').textContent = reductionActive ? '0.8% (đã giảm)' : '1%';

      // Calculate taxes
      const taxVatRetail = rRetail * rateVatRetail;
      const taxTncnRetail = rRetail * 0.005;

      const taxVatService = rService * rateVatService;
      const taxTncnService = rService * 0.02;

      const taxVatProduce = rProduce * rateVatProduce;
      const taxTncnProduce = rProduce * 0.015;

      const taxVatOther = rOther * rateVatOther;
      const taxTncnOther = rOther * 0.01;

      // Injects to table cell
      document.getElementById('td_rev_retail').textContent = formatMoney(rRetail);
      document.getElementById('td_tax_gtgt_retail').textContent = formatMoney(taxVatRetail);
      document.getElementById('td_tax_tncn_retail').textContent = formatMoney(taxTncnRetail);

      document.getElementById('td_rev_service').textContent = formatMoney(rService);
      document.getElementById('td_tax_gtgt_service').textContent = formatMoney(taxVatService);
      document.getElementById('td_tax_tncn_service').textContent = formatMoney(taxTncnService);

      document.getElementById('td_rev_produce').textContent = formatMoney(rProduce);
      document.getElementById('td_tax_gtgt_produce').textContent = formatMoney(taxVatProduce);
      document.getElementById('td_tax_tncn_produce').textContent = formatMoney(taxTncnProduce);

      document.getElementById('td_rev_other').textContent = formatMoney(rOther);
      document.getElementById('td_tax_gtgt_other').textContent = formatMoney(taxVatOther);
      document.getElementById('td_tax_tncn_other').textContent = formatMoney(taxTncnOther);

      // Totals
      const totalRev = rRetail + rService + rProduce + rOther;
      const totalVat = taxVatRetail + taxVatService + taxVatProduce + taxVatOther;
      const totalTncn = taxTncnRetail + taxTncnService + taxTncnProduce + taxTncnOther;

      document.getElementById('td_total_rev').textContent = formatMoney(totalRev);
      document.getElementById('td_total_gtgt').textContent = formatMoney(totalVat);
      document.getElementById('td_total_tncn').textContent = formatMoney(totalTncn);

      const totalPayable = totalVat + totalTncn;
      document.getElementById('totalPayableCNKD').textContent = `${formatMoney(totalPayable)} VND`;

      // Deadline text
      let deadlineStr = '';
      if (periodType === 'quarter') {
        deadlineStr = `Ngày cuối cùng của tháng đầu quý tiếp theo (30/04/${parseInt(year)})`;
      } else {
        deadlineStr = `Ngày thứ 20 của tháng tiếp theo (20/02/${parseInt(year)})`;
      }
      document.getElementById('taxDeadlineCNKD').textContent = deadlineStr;

    } else if (subject === 'qttncn') {
      // 2. QT TNCN Calculations
      const name = qttncnName.value || 'Trần Thị B';
      const mst = qttncnMst.value || '8198765432';
      document.querySelectorAll('.lbl_name_qt').forEach(el => el.textContent = name);
      document.querySelectorAll('.lbl_mst_qt').forEach(el => el.textContent = mst);

      const income = parseFloat(qttncnIncome.value) || 0;
      const numDeps = parseInt(qttncnDependents.value) || 0;
      const insPaid = parseFloat(qttncnInsurance.value) || 0;
      const taxWithheld = parseFloat(qttncnDeducted.value) || 0;

      // Personal deductions
      const selfDeduct = 132000000; // 11M/month * 12
      const depDeduct = numDeps * 4400000 * 12; // 4.4M/month * 12
      const totalFamilyDeduct = selfDeduct + depDeduct;

      document.getElementById('qt_income').textContent = formatMoney(income);
      document.getElementById('qt_deduct_family').textContent = formatMoney(totalFamilyDeduct);
      document.getElementById('qt_deduct_insurance').textContent = formatMoney(insPaid);

      // Taxable income
      const taxableIncome = Math.max(0, income - totalFamilyDeduct - insPaid);
      document.getElementById('qt_taxable_income').textContent = formatMoney(taxableIncome);

      // Progressive tax rates
      let taxDue = 0;
      let breakdownHtml = '';
      
      if (taxableIncome > 0) {
        let rem = taxableIncome;
        
        // Bậc 1: đến 60 triệu (5%)
        const b1 = Math.min(rem, 60000000);
        taxDue += b1 * 0.05;
        rem -= b1;
        breakdownHtml += `- Bậc 1 (đến 60tr): ${formatMoney(b1)} x 5% = ${formatMoney(b1 * 0.05)} đ<br/>`;

        if (rem > 0) {
          // Bậc 2: từ 60 triệu đến 120 triệu (10%)
          const b2 = Math.min(rem, 60000000);
          taxDue += b2 * 0.10;
          rem -= b2;
          breakdownHtml += `- Bậc 2 (60tr - 120tr): ${formatMoney(b2)} x 10% = ${formatMoney(b2 * 0.10)} đ<br/>`;
        }
        if (rem > 0) {
          // Bậc 3: từ 120 triệu đến 216 triệu (15%)
          const b3 = Math.min(rem, 96000000);
          taxDue += b3 * 0.15;
          rem -= b3;
          breakdownHtml += `- Bậc 3 (120tr - 216tr): ${formatMoney(b3)} x 15% = ${formatMoney(b3 * 0.15)} đ<br/>`;
        }
        if (rem > 0) {
          // Bậc 4: từ 216 triệu đến 384 triệu (20%)
          const b4 = Math.min(rem, 168000000);
          taxDue += b4 * 0.20;
          rem -= b4;
          breakdownHtml += `- Bậc 4 (216tr - 384tr): ${formatMoney(b4)} x 20% = ${formatMoney(b4 * 0.20)} đ<br/>`;
        }
        if (rem > 0) {
          // Bậc 5: từ 384 triệu đến 624 triệu (25%)
          const b5 = Math.min(rem, 240000000);
          taxDue += b5 * 0.25;
          rem -= b5;
          breakdownHtml += `- Bậc 5 (384tr - 624tr): ${formatMoney(b5)} x 25% = ${formatMoney(b5 * 0.25)} đ<br/>`;
        }
        if (rem > 0) {
          // Bậc 6: từ 624 triệu đến 960 triệu (30%)
          const b6 = Math.min(rem, 336000000);
          taxDue += b6 * 0.30;
          rem -= b6;
          breakdownHtml += `- Bậc 6 (624tr - 960tr): ${formatMoney(b6)} x 30% = ${formatMoney(b6 * 0.30)} đ<br/>`;
        }
        if (rem > 0) {
          // Bậc 7: trên 960 triệu (35%)
          taxDue += rem * 0.35;
          breakdownHtml += `- Bậc 7 (trên 960tr): ${formatMoney(rem)} x 35% = ${formatMoney(rem * 0.35)} đ<br/>`;
        }
      } else {
        breakdownHtml = 'Cá nhân không phát sinh thu nhập chịu thuế sau khi đã trừ gia cảnh và bảo hiểm.';
      }

      document.getElementById('qt_total_tax_due').textContent = formatMoney(taxDue);
      document.getElementById('qt_tax_withheld').textContent = formatMoney(taxWithheld);

      const netResult = taxDue - taxWithheld;
      const resultLabel = document.getElementById('qt_result_label');
      const resultCell = document.getElementById('qt_tax_result');

      if (netResult > 0) {
        resultLabel.textContent = 'SỐ THUẾ CÒN PHẢI NỘP THÊM (+)';
        resultCell.textContent = formatMoney(netResult);
        resultCell.className = 'border border-slate-800 p-2 text-right text-red-600 font-extrabold';
      } else {
        resultLabel.textContent = 'SỐ THUẾ ĐƯỢC HOÀN TRẢ (-)';
        resultCell.textContent = formatMoney(Math.abs(netResult));
        resultCell.className = 'border border-slate-800 p-2 text-right text-emerald-600 font-extrabold';
      }

      document.getElementById('qt_calculation_breakdown').innerHTML = breakdownHtml;

    } else if (subject === 'gtgt') {
      // 3. Doanh nghiệp GTGT Calculations
      const name = gtgtName.value || 'Công ty TNHH Thương mại X';
      const mst = gtgtMst.value || '0101234567';
      document.querySelectorAll('.lbl_name_company').forEach(el => el.textContent = name);
      document.querySelectorAll('.lbl_mst_company').forEach(el => el.textContent = mst);

      const rRetail = parseFloat(gtgtRevRetail.value) || 0;
      const rService = parseFloat(gtgtRevService.value) || 0;
      const rProduce = parseFloat(gtgtRevProduce.value) || 0;

      const reductionActive = gtgtVatReduction.value === 'detect';
      const rateVatRetail = reductionActive ? 0.008 : 0.01;
      const rateVatService = 0.05;
      const rateVatProduce = reductionActive ? 0.024 : 0.03;

      document.getElementById('gtgt_rate_retail_td').textContent = reductionActive ? '0.8% (đã giảm)' : '1%';

      const taxVatRetail = rRetail * rateVatRetail;
      const taxVatService = rService * rateVatService;
      const taxVatProduce = rProduce * rateVatProduce;

      document.getElementById('gtgt_rev_retail_td').textContent = formatMoney(rRetail);
      document.getElementById('gtgt_tax_retail_td').textContent = formatMoney(taxVatRetail);

      document.getElementById('gtgt_rev_service_td').textContent = formatMoney(rService);
      document.getElementById('gtgt_tax_service_td').textContent = formatMoney(taxVatService);

      document.getElementById('gtgt_rev_produce_td').textContent = formatMoney(rProduce);
      document.getElementById('gtgt_tax_produce_td').textContent = formatMoney(taxVatProduce);

      const totalRev = rRetail + rService + rProduce;
      const totalTax = taxVatRetail + taxVatService + taxVatProduce;

      document.getElementById('gtgt_total_rev_td').textContent = formatMoney(totalRev);
      document.getElementById('gtgt_total_tax_td').textContent = formatMoney(totalTax);
    }
  }

  // Listening inputs
  const allInputs = [
    taxYear, cnkdName, cnkdMst, cnkdRevRetail, cnkdRevService, cnkdRevProduce, cnkdRevOther, cnkdVatReduction,
    qttncnName, qttncnMst, qttncnIncome, qttncnDependents, qttncnInsurance, qttncnDeducted,
    gtgtName, gtgtMst, gtgtRevRetail, gtgtRevService, gtgtRevProduce, gtgtVatReduction
  ];
  allInputs.forEach(input => {
    input?.addEventListener('input', calculateAll);
    input?.addEventListener('change', calculateAll);
  });

  // --- EXPORTS LOGIC ---

  // XML HTKK EXPORT
  btnExportXML?.addEventListener('click', () => {
    const subject = taxSubject.value;
    const year = taxYear.value || '2026';
    const periodType = taxPeriod.value;
    const periodVal = taxPeriodVal.value;

    let xmlContent = '';

    if (subject === 'cnkd') {
      const name = cnkdName.value || 'Nguyễn Văn A';
      const mst = cnkdMst.value || '8012345678';
      const rRetail = parseFloat(cnkdRevRetail.value) || 0;
      const rService = parseFloat(cnkdRevService.value) || 0;
      const rProduce = parseFloat(cnkdRevProduce.value) || 0;
      const rOther = parseFloat(cnkdRevOther.value) || 0;
      const reduction = cnkdVatReduction.value === 'detect';

      const taxVatRetail = rRetail * (reduction ? 0.008 : 0.01);
      const taxTncnRetail = rRetail * 0.005;
      const totalVat = taxVatRetail;

      xmlContent = `<?xml version="1.0" encoding="UTF-8"?>
<HSoKhaiThue xmlns="http://www.gdt.gov.vn/schema/htkk">
  <Header>
    <MaNTT>${mst}</MaNTT>
    <TenNTT>${name}</TenNTT>
    <MaSoMau>01/CNKD</MaSoMau>
    <TenMauTờKhai>Tờ khai thuế đối với cá nhân kinh doanh</TenMauTờKhai>
    <KyTinhThue>${periodType === 'quarter' ? periodVal : 'M' + periodVal.replace('M', '')}</KyTinhThue>
    <NamTinhThue>${year}</NamTinhThue>
  </Header>
  <Body>
    <ToKhaiChinh>
      <DoanhThuRetail>${rRetail}</DoanhThuRetail>
      <ThueVatRetail>${taxVatRetail}</ThueVatRetail>
      <ThueTncnRetail>${taxTncnRetail}</ThueTncnRetail>
      <DoanhThuService>${rService}</DoanhThuService>
      <DoanhThuProduce>${rProduce}</DoanhThuProduce>
      <DoanhThuOther>${rOther}</DoanhThuOther>
      <TongThueVat>${totalVat}</TongThueVat>
      <GiamThueGTGT>${reduction ? 'YES' : 'NO'}</GiamThueGTGT>
    </ToKhaiChinh>
  </Body>
</HSoKhaiThue>`;

    } else if (subject === 'qttncn') {
      const name = qttncnName.value || 'Trần Thị B';
      const mst = qttncnMst.value || '8198765432';
      const income = parseFloat(qttncnIncome.value) || 0;
      const numDeps = parseInt(qttncnDependents.value) || 0;
      const insPaid = parseFloat(qttncnInsurance.value) || 0;
      const taxWithheld = parseFloat(qttncnDeducted.value) || 0;

      xmlContent = `<?xml version="1.0" encoding="UTF-8"?>
<HSoKhaiThue xmlns="http://www.gdt.gov.vn/schema/htkk">
  <Header>
    <MaNTT>${mst}</MaNTT>
    <TenNTT>${name}</TenNTT>
    <MaSoMau>02/QT-TNCN</MaSoMau>
    <TenMauTờKhai>Tờ khai quyết toán thuế thu nhập cá nhân</TenMauTờKhai>
    <NamTinhThue>${year}</NamTinhThue>
  </Header>
  <Body>
    <ToKhaiChinh>
      <TongThuNhapChiTieu22>${income}</TongThuNhapChiTieu22>
      <GiamTruBanThan>132000000</GiamTruBanThan>
      <SoNguoiPhuThuoc>${numDeps}</SoNguoiPhuThuoc>
      <GiamTruGiaCanh>${132000000 + (numDeps * 52800000)}</GiamTruGiaCanh>
      <BaoHiemBatBuoc>${insPaid}</BaoHiemBatBuoc>
      <ThueDaKhauTru>${taxWithheld}</ThueDaKhauTru>
    </ToKhaiChinh>
  </Body>
</HSoKhaiThue>`;

    } else {
      const name = gtgtName.value || 'Công ty TNHH Thương mại X';
      const mst = gtgtMst.value || '0101234567';
      const rRetail = parseFloat(gtgtRevRetail.value) || 0;
      const rService = parseFloat(gtgtRevService.value) || 0;
      const rProduce = parseFloat(gtgtRevProduce.value) || 0;
      const reduction = gtgtVatReduction.value === 'detect';

      xmlContent = `<?xml version="1.0" encoding="UTF-8"?>
<HSoKhaiThue xmlns="http://www.gdt.gov.vn/schema/htkk">
  <Header>
    <MaNTT>${mst}</MaNTT>
    <TenNTT>${name}</TenNTT>
    <MaSoMau>01/GTGT</MaSoMau>
    <TenMauTờKhai>Tờ khai thuế giá trị gia tăng trực tiếp</TenMauTờKhai>
    <NamTinhThue>${year}</NamTinhThue>
  </Header>
  <Body>
    <ToKhaiChinh>
      <DoanhThuHangHoa>${rRetail}</DoanhThuHangHoa>
      <DoanhThuDichVu>${rService}</DoanhThuDichVu>
      <DoanhThuSanXuat>${rProduce}</DoanhThuSanXuat>
      <GiamThue2PhanTram>${reduction ? '20%' : '0'}</GiamThue2PhanTram>
    </ToKhaiChinh>
  </Body>
</HSoKhaiThue>`;
    }

    // Trigger download
    const blob = new Blob([xmlContent], { type: 'text/xml;charset=utf-8;' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.setAttribute('download', `to_khai_thue_${subject}_${year}.xml`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });

  // MS OFFICE HTML EXPORTS
  function downloadOfficeFile(htmlContent, filename, type) {
    let blob;
    if (type === 'excel') {
      const excelTemplate = `<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">
      <head>
        <!--[if gte mso 9]>
        <xml>
          <x:ExcelWorkbook>
            <x:ExcelWorksheets>
              <x:ExcelWorksheet>
                <x:Name>To Khai Thue</x:Name>
                <x:WorksheetOptions>
                  <x:DisplayGridlines/>
                </x:WorksheetOptions>
              </x:ExcelWorksheet>
            </x:ExcelWorksheets>
          </x:ExcelWorkbook>
        </xml>
        <![endif]-->
        <meta charset="utf-8">
      </head>
      <body style="font-family: Arial, sans-serif;">
        ${htmlContent}
      </body>
      </html>`;
      blob = new Blob([excelTemplate], { type: 'application/vnd.ms-excel;charset=utf-8;' });
    } else {
      const wordTemplate = `<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
      <head>
        <meta charset="utf-8">
        <style>
          body { font-family: 'Times New Roman', serif; line-height: 1.5; }
          table { width: 100%; border-collapse: collapse; margin-top: 15px; }
          th, td { border: 1px solid #000; padding: 6px; text-align: left; }
        </style>
      </head>
      <body>
        ${htmlContent}
      </body>
      </html>`;
      blob = new Blob([wordTemplate], { type: 'application/msword;charset=utf-8;' });
    }

    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.setAttribute('download', filename);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  }

  btnExportExcel?.addEventListener('click', () => {
    const subject = taxSubject.value;
    const year = taxYear.value || '2026';
    const activeDoc = document.querySelector(
      subject === 'cnkd' ? '#document_content_cnkd' : subject === 'qttncn' ? '#document_content_qttncn' : '#document_content_gtgt'
    );
    downloadOfficeFile(activeDoc.innerHTML, `to_khai_thue_${subject}_${year}.xls`, 'excel');
  });

  btnExportWord?.addEventListener('click', () => {
    const subject = taxSubject.value;
    const year = taxYear.value || '2026';
    const activeDoc = document.querySelector(
      subject === 'cnkd' ? '#document_content_cnkd' : subject === 'qttncn' ? '#document_content_qttncn' : '#document_content_gtgt'
    );
    downloadOfficeFile(activeDoc.innerHTML, `to_khai_thue_${subject}_${year}.doc`, 'word');
  });

  btnPrintPDF?.addEventListener('click', () => {
    window.print();
  });

  // Calculate on startup
  calculateAll();
