---
import Layout from '../../../layouts/Layout.astro';
import StatsBadge from '../../../components/StatsBadge.astro';
---

<Layout 
  title="Khai Thuế Hộ Kinh Doanh, Cá Nhân & Doanh Nghiệp - Tạo Tờ Khai Thuế Online"
  description="Công cụ trực tuyến hỗ trợ khai thuế hộ kinh doanh (01/CNKD), tự quyết toán thuế thu nhập cá nhân (02/QT-TNCN) và khai thuế doanh nghiệp (01/GTGT). Tự động tính thuế suất, giảm thuế GTGT 2% và kết xuất XML nộp HTKK."
>
  <!-- Background radial glow -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(37,99,235,0.03),transparent_50%)] pointer-events-none z-0"></div>

  <main class="max-w-6xl mx-auto px-4 py-12 w-full z-10 relative">
    
    <!-- Breadcrumb -->
    <nav class="flex text-sm text-slate-500 mb-8" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a href="/" class="hover:text-brand-blue dark:hover:text-brand-mint">Trang chủ</a>
        </li>
        <li>
          <div class="flex items-center">
            <span class="mx-2 text-slate-400">/</span>
            <a href="/calculators/" class="hover:text-brand-blue dark:hover:text-brand-mint">Công Cụ</a>
          </div>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <span class="mx-2 text-slate-400">/</span>
            <span class="text-slate-400 dark:text-slate-500">Tạo tờ khai thuế</span>
          </div>
        </li>
      </ol>
    </nav>

    <!-- Hero Header -->
    <div class="max-w-3xl mx-auto text-center mb-12">
      <span class="px-3.5 py-1 text-xs font-bold rounded-full bg-brand-blue/10 text-brand-blue dark:bg-brand-mint/10 dark:text-brand-mint mb-3 inline-block">
        Mẫu Biểu Mới Nhất 2026
      </span>
      <h1 class="text-3xl sm:text-4xl font-heading font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
        Công Cụ Tạo Tờ Khai Thuế Online
      </h1>
      <p class="text-base text-slate-600 dark:text-slate-400">
        Tự động tính thuế, điền tờ khai chính, lập phụ lục doanh thu và phụ lục giảm thuế GTGT 2%. Xuất file XML chuẩn HTKK, Word hoặc Excel tức thì.
      </p>
    </div>

    <!-- Main Container Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16">
      
      <!-- Input Panel (5 Cols) -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Step 1: Selection & Configuration -->
        <div class="p-6 bg-white dark:bg-brand-darkCard border border-slate-200/80 dark:border-slate-800/80 rounded-2xl shadow-sm space-y-4">
          <h2 class="text-lg font-heading font-bold text-slate-900 dark:text-white flex items-center gap-2">
            ⚙️ Cấu hình Tờ khai
          </h2>

          <!-- Đối tượng kê khai -->
          <div>
            <label for="taxSubject" class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2">Đối tượng kê khai</label>
            <select id="taxSubject" class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 font-bold focus:outline-none focus:ring-2 focus:ring-brand-blue">
              <option value="cnkd">Hộ kinh doanh, cá nhân KD (Mẫu 01/CNKD)</option>
              <option value="qttncn">Cá nhân quyết toán TNCN (Mẫu 02/QT-TNCN)</option>
              <option value="gtgt">Doanh nghiệp (Trực tiếp GTGT - Mẫu 01/GTGT)</option>
            </select>
          </div>

          <!-- Kỳ kê khai và năm -->
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="taxPeriod" class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2">Kỳ kê khai</label>
              <select id="taxPeriod" class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-blue">
                <option value="quarter">Theo Quý</option>
                <option value="month">Theo Tháng</option>
              </select>
            </div>
            <div>
              <label id="periodDetailLabel" for="taxPeriodVal" class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2">Chọn Quý</label>
              <select id="taxPeriodVal" class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-blue">
                <!-- Quý default options -->
                <option value="Q1">Quý I</option>
                <option value="Q2">Quý II</option>
                <option value="Q3">Quý III</option>
                <option value="Q4">Quý IV</option>
              </select>
            </div>
          </div>

          <!-- Năm tính thuế -->
          <div>
            <label for="taxYear" class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2">Năm tính thuế</label>
            <input type="number" id="taxYear" value="2026" min="2020" max="2030" class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 font-bold focus:outline-none focus:ring-2 focus:ring-brand-blue" />
          </div>
        </div>

        <!-- Step 2: Dynamic Inputs based on Subject Selection -->
        <div class="p-6 bg-white dark:bg-brand-darkCard border border-slate-200/80 dark:border-slate-800/80 rounded-2xl shadow-sm">
          <h2 class="text-lg font-heading font-bold text-slate-900 dark:text-white flex items-center gap-2 mb-6">
            📝 Dữ liệu Kê khai
          </h2>

          <!-- 1. HỘ KINH DOANH INPUTS -->
          <div id="subject_cnkd" class="space-y-4">
            <div class="p-3 bg-amber-500/5 border border-amber-500/20 rounded-xl mb-4 text-xs text-amber-600 dark:text-amber-400 leading-relaxed font-medium">
              ⚠️ Chỉ cá nhân kinh doanh có doanh thu trên 100 triệu đồng/năm mới thuộc diện nộp thuế GTGT & TNCN.
            </div>

            <!-- Tên HKD / Địa chỉ -->
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="cnkd_name" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Tên người nộp thuế</label>
                <input type="text" id="cnkd_name" value="Nguyễn Văn A" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue" />
              </div>
              <div>
                <label for="cnkd_mst" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Mã số thuế</label>
                <input type="text" id="cnkd_mst" value="8012345678" placeholder="Nhập 10 chữ số" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-sm font-bold focus:outline-none focus:ring-2 focus:ring-brand-blue" />
              </div>
            </div>

            <!-- Ngành nghề chịu thuế và doanh thu -->
            <div class="space-y-3 pt-2">
              <span class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Doanh thu tính thuế phát sinh trong kỳ:</span>
              
              <div>
                <label for="cnkd_rev_retail" class="block text-xs text-slate-500 dark:text-slate-400 mb-1">1. Phân phối, bán lẻ hàng hóa (GTGT 1% - TNCN 0.5%)</label>
                <input type="number" id="cnkd_rev_retail" value="150000000" class="w-full px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 font-bold text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue" />
              </div>

              <div>
                <label for="cnkd_rev_service" class="block text-xs text-slate-500 dark:text-slate-400 mb-1">2. Dịch vụ, xây dựng không bao thầu (GTGT 5% - TNCN 2%)</label>
                <input type="number" id="cnkd_rev_service" value="0" class="w-full px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 font-bold text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue" />
              </div>

              <div>
                <label for="cnkd_rev_produce" class="block text-xs text-slate-500 dark:text-slate-400 mb-1">3. Sản xuất, vận tải, có gắn hàng hóa (GTGT 3% - TNCN 1.5%)</label>
                <input type="number" id="cnkd_rev_produce" value="0" class="w-full px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 font-bold text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue" />
              </div>

              <div>
                <label for="cnkd_rev_other" class="block text-xs text-slate-500 dark:text-slate-400 mb-1">4. Hoạt động kinh doanh khác (GTGT 2% - TNCN 1%)</label>
                <input type="number" id="cnkd_rev_other" value="0" class="w-full px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 font-bold text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue" />
              </div>
            </div>

            <!-- Giảm thuế GTGT 2% -->
            <div class="pt-4 border-t border-slate-200 dark:border-slate-800">
              <label for="cnkd_vat_reduction" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-2">Chính sách giảm thuế GTGT (Nghị quyết 2%):</label>
              <select id="cnkd_vat_reduction" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-xs focus:outline-none focus:ring-2 focus:ring-brand-blue">
                <option value="detect">Tự động phát hiện (Giảm 20% tỷ lệ tính thuế GTGT)</option>
                <option value="no">Không áp dụng giảm thuế</option>
              </select>
              <div id="vat_reduction_notice" class="mt-2 text-[10px] text-emerald-600 dark:text-brand-mint font-medium leading-relaxed">
                👉 Hệ thống tự phát hiện nhóm ngành được giảm 20% mức thuế suất GTGT trực tiếp (Ví dụ: tỷ lệ GTGT bán lẻ giảm từ 1% xuống 0.8%).
              </div>
            </div>
          </div>

          <!-- 2. CÁ NHÂN QUYẾT TOÁN TNCN INPUTS -->
          <div id="subject_qttncn" class="space-y-4 hidden">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="qttncn_name" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Họ tên cá nhân</label>
                <input type="text" id="qttncn_name" value="Trần Thị B" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue" />
              </div>
              <div>
                <label for="qttncn_mst" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Mã số thuế cá nhân</label>
                <input type="text" id="qttncn_mst" value="8198765432" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-sm font-bold focus:outline-none focus:ring-2 focus:ring-brand-blue" />
              </div>
            </div>

            <!-- Tổng thu nhập năm -->
            <div>
              <label for="qttncn_income" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Tổng thu nhập chịu thuế trong năm (VND)</label>
              <input type="number" id="qttncn_income" value="360000000" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 font-bold text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue" />
            </div>

            <!-- Số người phụ thuộc -->
            <div>
              <label for="qttncn_dependents" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Số người phụ thuộc (Thời gian giảm trừ đủ 12 tháng)</label>
              <input type="number" id="qttncn_dependents" value="1" min="0" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 font-bold text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue" />
            </div>

            <!-- Bảo hiểm đã đóng -->
            <div>
              <label for="qttncn_insurance" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Bảo hiểm bắt buộc đã đóng trong năm (VND)</label>
              <input type="number" id="qttncn_insurance" value="28800000" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 font-bold text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue" />
            </div>

            <!-- Thuế đã khấu trừ -->
            <div>
              <label for="qttncn_deducted" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Số thuế TNCN doanh nghiệp đã khấu trừ (VND)</label>
              <input type="number" id="qttncn_deducted" value="12000000" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 font-bold text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue" />
            </div>
          </div>

          <!-- 3. DOANH NGHIỆP TRỰC TIẾP INPUTS -->
          <div id="subject_gtgt" class="space-y-4 hidden">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="gtgt_name" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Tên doanh nghiệp</label>
                <input type="text" id="gtgt_name" value="Công ty TNHH Thương mại X" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue" />
              </div>
              <div>
                <label for="gtgt_mst" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Mã số thuế</label>
                <input type="text" id="gtgt_mst" value="0101234567" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-sm font-bold focus:outline-none focus:ring-2 focus:ring-brand-blue" />
              </div>
            </div>

            <div class="space-y-3 pt-2">
              <span class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Doanh thu tính thuế GTGT trực tiếp:</span>

              <div>
                <label for="gtgt_rev_retail" class="block text-xs text-slate-500 dark:text-slate-400 mb-1">1. Phân phối, bán lẻ hàng hóa (Thuế GTGT 1%)</label>
                <input type="number" id="gtgt_rev_retail" value="500000000" class="w-full px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 font-bold text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue" />
              </div>

              <div>
                <label for="gtgt_rev_service" class="block text-xs text-slate-500 dark:text-slate-400 mb-1">2. Dịch vụ, xây dựng không bao thầu (Thuế GTGT 5%)</label>
                <input type="number" id="gtgt_rev_service" value="0" class="w-full px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 font-bold text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue" />
              </div>

              <div>
                <label for="gtgt_rev_produce" class="block text-xs text-slate-500 dark:text-slate-400 mb-1">3. Sản xuất, vận tải, xây dựng có bao thầu (Thuế GTGT 3%)</label>
                <input type="number" id="gtgt_rev_produce" value="0" class="w-full px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 font-bold text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue" />
              </div>
            </div>

            <!-- Giảm thuế GTGT 2% cho doanh nghiệp -->
            <div class="pt-4 border-t border-slate-200 dark:border-slate-800">
              <label for="gtgt_vat_reduction" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-2">Chính sách giảm thuế GTGT (Nghị quyết 2%):</label>
              <select id="gtgt_vat_reduction" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-xs focus:outline-none focus:ring-2 focus:ring-brand-blue">
                <option value="detect">Tự động áp dụng (Giảm 20% mức tính thuế GTGT)</option>
                <option value="no">Không áp dụng giảm thuế</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Export Buttons Action Panel -->
        <div class="p-6 bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800/80 rounded-2xl shadow-sm space-y-3">
          <button id="btnExportXML" class="w-full bg-[#0063b6] hover:bg-blue-700 text-white font-bold py-3.5 px-4 rounded-xl transition duration-200 flex items-center justify-center gap-2 shadow">
            📥 Xuất XML chuẩn HTKK
          </button>
          <div class="grid grid-cols-2 gap-3">
            <button id="btnExportExcel" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-3 rounded-xl transition duration-200 flex items-center justify-center gap-1.5 text-sm shadow">
              📊 Xuất file Excel
            </button>
            <button id="btnExportWord" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-3 rounded-xl transition duration-200 flex items-center justify-center gap-1.5 text-sm shadow">
              📝 Xuất bản Word
            </button>
          </div>
          <button id="btnPrintPDF" class="w-full bg-slate-700 hover:bg-slate-800 dark:bg-slate-800 dark:hover:bg-slate-700 text-white font-bold py-3 px-4 rounded-xl transition duration-200 flex items-center justify-center gap-2 shadow text-sm">
            🖨️ In tờ khai (PDF)
          </button>
        </div>

      </div>

      <!-- Preview Panel (7 Cols) -->
      <div class="lg:col-span-7 flex flex-col">
        <div class="p-6 bg-white dark:bg-brand-darkCard border border-slate-200/80 dark:border-slate-800/80 rounded-2xl shadow-sm flex-1 overflow-x-auto min-w-0">
          <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4 mb-6">
            <h3 class="font-heading font-bold text-slate-900 dark:text-white flex items-center gap-2">
              👀 Xem trước Tờ khai & Phụ lục
            </h3>
            <span class="text-xs font-semibold px-2.5 py-1 bg-slate-100 dark:bg-slate-800 text-slate-500 rounded-lg">
              Chỉ số tự động tính toán
            </span>
          </div>

          <!-- Document Render Frame (yellowish form style) -->
          <div id="printDocumentFrame" class="p-6 bg-[#fffdf0] text-slate-900 rounded-xl border border-amber-200/50 shadow-inner font-sans text-xs min-w-[640px]">
            <!-- Dynamic Content Injected here by Javascript -->
            <div id="document_content_cnkd" class="space-y-6">
              <!-- Form Header -->
              <div class="text-center font-bold uppercase space-y-1">
                <div>CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
                <div class="text-[10px] lowercase normal-case italic font-normal">Độc lập - Tự do - Hạnh phúc</div>
                <div class="h-px bg-slate-800 w-24 mx-auto my-2"></div>
                <div class="text-sm font-extrabold pt-2">TỜ KHAI THUẾ ĐỐI VỚI CÁ NHÂN KINH DOANH</div>
                <div class="text-[10px] font-normal normal-case italic">(Áp dụng cho cá nhân kinh doanh, hộ kinh doanh nộp thuế theo phương pháp kê khai)</div>
                <div class="text-[10px] font-semibold mt-1">Kỳ tính thuế: <span class="tax-period-title font-extrabold">Quý I/2026</span></div>
              </div>

              <!-- Information Block -->
              <div class="space-y-1 border-t border-b border-slate-400 py-3 mt-4">
                <div><strong>[01] Tên người nộp thuế:</strong> <span class="lbl_name">Nguyễn Văn A</span></div>
                <div><strong>[02] Mã số thuế:</strong> <span class="lbl_mst">8012345678</span></div>
                <div><strong>[03] Địa chỉ kinh doanh:</strong> 63 Tỉnh thành, Việt Nam</div>
              </div>

              <!-- Table Data -->
              <div>
                <div class="font-bold mb-2 uppercase text-[10px] tracking-wider">A. Chỉ tiêu tính thuế doanh thu & thuế suất:</div>
                <table class="w-full border-collapse border border-slate-800 text-left">
                  <thead>
                    <tr class="bg-slate-200/60 font-bold">
                      <th class="border border-slate-800 p-2 text-center w-8">STT</th>
                      <th class="border border-slate-800 p-2">Danh mục nhóm ngành nghề kinh doanh</th>
                      <th class="border border-slate-800 p-2 text-center w-28">Doanh thu chịu thuế</th>
                      <th class="border border-slate-800 p-2 text-center w-20">Tỷ lệ thuế GTGT</th>
                      <th class="border border-slate-800 p-2 text-center w-20">Tỷ lệ thuế TNCN</th>
                      <th class="border border-slate-800 p-2 text-center w-24">Thuế GTGT phải nộp</th>
