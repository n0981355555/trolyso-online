    title: { vi: "Cắt / Chia File PDF", en: "Split / Cut PDF Document" },
    desc: {
      vi: "Tách trang PDF hoặc trích xuất một nhóm trang cụ thể thành file PDF mới trực tuyến nhanh chóng.",
      en: "Separate PDF pages or extract a specific range of pages into a new PDF document online quickly."
    },
    url: "/calculators/cat-pdf/",
    category: "office",
    icon: "✂️",
