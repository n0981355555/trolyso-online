---

<Layout 
  title="Công Cụ & Máy Tính Online - Trợ Lý Số"
  description="Danh sách tổng hợp các công cụ tiện ích, tính toán tài chính, bảo hiểm, học tập, văn phòng và giải trí trực tuyến hoàn toàn miễn phí."
>
  <!-- Ambient background decor -->
  <div class="absolute top-0 inset-x-0 h-96 bg-gradient-to-b from-blue-400/5 dark:from-blue-600/5 to-transparent pointer-events-none z-0"></div>

  <main class="max-w-6xl mx-auto px-4 py-12 w-full z-10 relative">
    
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h1 class="text-3xl sm:text-4xl font-heading font-extrabold text-slate-900 dark:text-white tracking-tight mb-4" id="pageTitle">
        Công Cụ & Máy Tính Tiện Ích Online
      </h1>
      <p class="text-base text-slate-500 dark:text-slate-400 leading-relaxed" id="pageDesc">
        Tổng hợp tất cả các công cụ trực tuyến miễn phí của Trợ Lý Số. Chọn nhóm danh mục bên dưới hoặc tìm kiếm nhanh để bắt đầu.
      </p>
    </div>

    <!-- Search & Tabs Container -->
    <div class="mb-10 space-y-6">
      
      <!-- Live Search Box -->
      <div class="max-w-xl mx-auto relative">
        <input 
          type="text" 
          id="toolsSearchInput" 
          placeholder="Tìm kiếm công cụ nhanh..." 
          aria-label="Tìm kiếm công cụ"
          class="w-full pl-12 pr-4 py-3.5 rounded-2xl border border-slate-200 dark:border-slate-800/80 bg-white/70 dark:bg-brand-darkCard/50 backdrop-blur-sm focus:outline-none focus:ring-2 focus:ring-brand-blue dark:focus:ring-brand-mint text-sm transition-all shadow-sm"
        />
        <svg class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>

      <!-- Categories Filter Tabs -->
      <div class="flex justify-start md:justify-center overflow-x-auto pb-2 scrollbar-none gap-2 px-1 select-none">
        <button class="tab-btn px-4 py-2 text-xs sm:text-sm font-bold rounded-xl transition duration-200 bg-brand-blue text-white dark:bg-brand-mint dark:text-slate-950 flex items-center gap-1.5 shrink-0" data-category="all" id="tabAll">
          🌟 <span class="tab-text">Tất cả</span>
        </button>
        <button class="tab-btn px-4 py-2 text-xs sm:text-sm font-bold rounded-xl transition duration-200 text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200 bg-white dark:bg-brand-darkCard border border-slate-200/50 dark:border-slate-800/50 flex items-center gap-1.5 shrink-0" data-category="finance" id="tabFinance">
          💵 <span class="tab-text">Tài chính & Thuế</span>
        </button>
        <button class="tab-btn px-4 py-2 text-xs sm:text-sm font-bold rounded-xl transition duration-200 text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200 bg-white dark:bg-brand-darkCard border border-slate-200/50 dark:border-slate-800/50 flex items-center gap-1.5 shrink-0" data-category="insurance" id="tabInsurance">
          🛡️ <span class="tab-text">Lương & Bảo hiểm</span>
        </button>
        <button class="tab-btn px-4 py-2 text-xs sm:text-sm font-bold rounded-xl transition duration-200 text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200 bg-white dark:bg-brand-darkCard border border-slate-200/50 dark:border-slate-800/50 flex items-center gap-1.5 shrink-0" data-category="utility" id="tabEducation">
          🎓 <span class="tab-text">Học tập & Giáo dục</span>
        </button>
        <button class="tab-btn px-4 py-2 text-xs sm:text-sm font-bold rounded-xl transition duration-200 text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200 bg-white dark:bg-brand-darkCard border border-slate-200/50 dark:border-slate-800/50 flex items-center gap-1.5 shrink-0" data-category="office" id="tabOffice">
          🖇️ <span class="tab-text">Văn phòng & PDF</span>
        </button>
        <button class="tab-btn px-4 py-2 text-xs sm:text-sm font-bold rounded-xl transition duration-200 text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200 bg-white dark:bg-brand-darkCard border border-slate-200/50 dark:border-slate-800/50 flex items-center gap-1.5 shrink-0" data-category="entertainment" id="tabEntertainment">
          🔮 <span class="tab-text">Tiện ích & Giải trí</span>
        </button>
      </div>

    </div>

    <!-- Calculators Grid -->
    <div id="calculators-index-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 min-h-[200px]">
      {calculators.map(calc => (
        <a 
          href={calc.url} 
          data-category={calc.category}
          data-title-vi={calc.title.vi}
          data-title-en={calc.title.en}
          data-desc-vi={calc.desc.vi}
          data-desc-en={calc.desc.en}
          class="calc-card group p-6 bg-white dark:bg-brand-darkCard border border-slate-200/60 dark:border-slate-800/50 rounded-2xl shadow-sm hover:shadow-xl hover:-translate-y-1 hover:border-brand-blue/30 dark:hover:border-brand-mint/30 active:scale-[0.99] transition-all duration-300 flex flex-col justify-between relative overflow-hidden"
        >
          <div>
            <!-- Icon Wrapper -->
            <div class={`w-12 h-12 rounded-xl flex items-center justify-center mb-4 transition-colors duration-300 text-2xl bg-slate-100 dark:bg-slate-800/60`}>
              {calc.icon}
            </div>
            <!-- Title -->
            <h4 class="font-heading font-bold text-lg text-slate-900 dark:text-white group-hover:text-brand-blue dark:group-hover:text-brand-mint transition mb-2 calc-card-title">
              {calc.title.vi}
            </h4>
            <!-- Description -->
            <p class="text-sm text-slate-500 dark:text-slate-400 calc-card-desc leading-relaxed">
              {calc.desc.vi}
            </p>
          </div>
          <div class="mt-4 flex items-center justify-between">
            <StatsBadge slug={calc.slug} type="tool" showLiveDot={false} />
            <div class="text-xs text-brand-blue dark:text-brand-mint font-bold flex items-center gap-1 group-hover:gap-2 transition-all open-tool-text">
              Mở công cụ <span>→</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="text-center py-16 hidden">
      <div class="text-5xl mb-4">🔍</div>
      <h3 class="text-lg font-heading font-bold text-slate-800 dark:text-slate-200 mb-1" id="emptyTitle">Không tìm thấy công cụ</h3>
      <p class="text-sm text-slate-500 dark:text-slate-400" id="emptyDesc">Vui lòng thử từ khóa khác hoặc chuyển danh mục.</p>
    </div>

  </main>
</Layout>

<script is:inline>
  // Bilingual translations for static page elements
  const pageTranslations = {
    vi: {
      title: "Công Cụ & Máy Tính Tiện Ích Online",
      desc: "Tổng hợp tất cả các công cụ trực tuyến miễn phí của Trợ Lý Số. Chọn nhóm danh mục bên dưới hoặc tìm kiếm nhanh để bắt đầu.",
      placeholder: "Tìm kiếm công cụ nhanh...",
      tabAll: "Tất cả",
      tabFinance: "Tài chính & Thuế",
      tabInsurance: "Lương & Bảo hiểm",
      tabEducation: "Học tập & Giáo dục",
      tabOffice: "Văn phòng & PDF",
      tabEntertainment: "Tiện ích & Giải trí",
      openTool: "Mở công cụ",
      emptyTitle: "Không tìm thấy công cụ",
      emptyDesc: "Vui lòng thử từ khóa khác hoặc chuyển danh mục."
    },
    en: {
      title: "Online Calculation & Helper Tools",
      desc: "A comprehensive list of free web tools on TroLySo. Select a category tab below or perform a search to get started.",
      placeholder: "Search tools quickly...",
      tabAll: "All",
      tabFinance: "Finance & Tax",
      tabInsurance: "Salary & Insurance",
      tabEducation: "Study & MOET",
      tabOffice: "Office & PDF",
      tabEntertainment: "Utilities & Fun",
      openTool: "Open Tool",
      emptyTitle: "No tools found",
      emptyDesc: "Please try another keyword or switch categories."
    }
  };

  function removeVietnameseTones(str) {
    let result = str.toLowerCase();
    result = result.replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, "a");
    result = result.replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ/g, "e");
    result = result.replace(/ì|í|ị|ỉ|ĩ/g, "i");
    result = result.replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g, "o");
    result = result.replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, "u");
    result = result.replace(/ỳ|ý|ỵ|ỷ|ỹ/g, "y");
    result = result.replace(/đ/g, "d");
    result = result.replace(/[^a-z0-9\s]/g, ""); 
    return result.normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
  }

  // Active state filter variables
  let currentCategory = 'all';
  let searchQuery = '';

  const cards = document.querySelectorAll('.calc-card');
  const searchInput = document.getElementById('toolsSearchInput');
  const tabButtons = document.querySelectorAll('.tab-btn');
  const emptyState = document.getElementById('empty-state');

  // Load language settings
  function updateLanguage() {
    const lang = localStorage.getItem('lang') === 'en' ? 'en' : 'vi';
    const dict = pageTranslations[lang];

    // Page headers
    const titleEl = document.getElementById('pageTitle');
    const descEl = document.getElementById('pageDesc');
    if (titleEl) titleEl.textContent = dict.title;
    if (descEl) descEl.textContent = dict.desc;

    // Search placeholder
    if (searchInput) searchInput.placeholder = dict.placeholder;

    // Tab texts
    const tabAllText = document.querySelector('#tabAll .tab-text');
    const tabFinanceText = document.querySelector('#tabFinance .tab-text');
    const tabInsuranceText = document.querySelector('#tabInsurance .tab-text');
    const tabEducationText = document.querySelector('#tabEducation .tab-text');
    const tabOfficeText = document.querySelector('#tabOffice .tab-text');
    const tabEntertainmentText = document.querySelector('#tabEntertainment .tab-text');

    if (tabAllText) tabAllText.textContent = dict.tabAll;
    if (tabFinanceText) tabFinanceText.textContent = dict.tabFinance;
    if (tabInsuranceText) tabInsuranceText.textContent = dict.tabInsurance;
    if (tabEducationText) tabEducationText.textContent = dict.tabEducation;
    if (tabOfficeText) tabOfficeText.textContent = dict.tabOffice;
    if (tabEntertainmentText) tabEntertainmentText.textContent = dict.tabEntertainment;

    // Empty state
    const emptyTitleEl = document.getElementById('emptyTitle');
    const emptyDescEl = document.getElementById('emptyDesc');
    if (emptyTitleEl) emptyTitleEl.textContent = dict.emptyTitle;
    if (emptyDescEl) emptyDescEl.textContent = dict.emptyDesc;

    // Card texts
    cards.forEach(card => {
      const titleVi = card.getAttribute('data-title-vi');
      const titleEn = card.getAttribute('data-title-en');
      const descVi = card.getAttribute('data-data-desc-vi') || card.getAttribute('data-desc-vi');
      const descEn = card.getAttribute('data-data-desc-en') || card.getAttribute('data-desc-en');

      const titleEl = card.querySelector('.calc-card-title');
      const descEl = card.querySelector('.calc-card-desc');
      const actionEl = card.querySelector('.open-tool-text');

      if (titleEl) titleEl.textContent = lang === 'en' ? titleEn : titleVi;
      if (descEl) descEl.textContent = lang === 'en' ? descEn : descVi;
      if (actionEl) {
        actionEl.innerHTML = `${dict.openTool} <span>→</span>`;
      }
    });
  }

  // Filter functionality
  function filterTools() {
    const lang = localStorage.getItem('lang') === 'en' ? 'en' : 'vi';
    const normQuery = removeVietnameseTones(searchQuery);
    let visibleCount = 0;

    cards.forEach(card => {
      const category = card.getAttribute('data-category');
      const title = card.getAttribute(`data-title-${lang}`).toLowerCase();
      const desc = card.getAttribute(`data-desc-${lang}`).toLowerCase();
      
      const normTitle = removeVietnameseTones(title);
      const normDesc = removeVietnameseTones(desc);

      const matchesCategory = currentCategory === 'all' || category === currentCategory;
      const matchesSearch = !searchQuery || 
        normTitle.includes(normQuery) || 
        normDesc.includes(normQuery);

      if (matchesCategory && matchesSearch) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (visibleCount === 0) {
      emptyState.classList.remove('hidden');
    } else {
      emptyState.classList.add('hidden');
    }
  }

  // Search input handler
  let searchTimeout = null;
  searchInput?.addEventListener('input', (e) => {
    searchQuery = e.target.value.trim();
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(filterTools, 100);
  });

  // Tab switcher handler
  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      // Toggle active classes
      tabButtons.forEach(b => {
        b.classList.remove('bg-brand-blue', 'text-white', 'dark:bg-brand-mint', 'dark:text-slate-950');
        b.classList.add('text-slate-500', 'hover:text-slate-800', 'dark:text-slate-400', 'dark:hover:text-slate-200', 'bg-white', 'dark:bg-brand-darkCard', 'border', 'border-slate-200/50', 'dark:border-slate-800/50');
      });

      btn.classList.add('bg-brand-blue', 'text-white', 'dark:bg-brand-mint', 'dark:text-slate-950');
      btn.classList.remove('text-slate-500', 'hover:text-slate-800', 'dark:text-slate-400', 'dark:hover:text-slate-200', 'bg-white', 'dark:bg-brand-darkCard', 'border', 'border-slate-200/50', 'dark:border-slate-800/50');

      currentCategory = btn.getAttribute('data-category');
      filterTools();
    });
  });

  // Listen to global i18n event
  window.addEventListener('languageChanged', () => {
    updateLanguage();
    filterTools();
  });

  // Init translations
  document.addEventListener('DOMContentLoaded', () => {
    updateLanguage();
    filterTools();
  });
  // Fallback if DOMContentLoaded already fired
  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    updateLanguage();
    filterTools();
  }
</script>
