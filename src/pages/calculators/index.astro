    color: "cyan"
  },
  {
    slug: "giai-ma-giac-mo",
    title: { vi: "Giải Mã Điềm Báo Giấc Mơ", en: "Dream Interpreter Online" },
    desc: {
      vi: "Tra cứu ý nghĩa điềm báo tâm linh các giấc mơ của bạn và gợi ý các con số may mắn tương ứng chính xác.",
      en: "Look up spiritual meanings of your dreams and suggest corresponding lucky numbers accurately."
    },
