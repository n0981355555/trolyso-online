    color: "slate"
  },
  {
    slug: "regex-explainer",
    title: { vi: "Giải Thích Biểu Thức Chính Quy Regex", en: "Regex Explainer Tool" },
    desc: {
      vi: "Phân tích, giải thích chi tiết cấu trúc Regex của bạn và kiểm tra khớp chuỗi dữ liệu trực quan.",
      en: "Analyze and explain your Regular Expressions (Regex) structure and test match patterns visually."
    },
    url: "/calculators/regex-explainer/",
