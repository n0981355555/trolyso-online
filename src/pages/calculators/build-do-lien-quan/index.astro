  // Add item
  function addItemToBuild(item) {
    currentBuild[selectedSlot] = item;
    
    const slotEl = buildSlots[selectedSlot];
    const nameEl = slotEl.querySelector('.slot-name');
    const iconWrapper = slotEl.querySelector('.rounded-full');

    iconWrapper.innerHTML = `<span class="text-2xl">${item.icon}</span><div class="slot-delete absolute top-0 right-0 bg-red-500 text-white w-4 h-4 rounded-full text-[9px] flex items-center justify-center shadow-md">✕</div>`;
    nameEl.innerText = t(item.name);

    iconWrapper.querySelector('.slot-delete').addEventListener('click', (e) => {
      e.stopPropagation();
      removeItemFromSlot(selectedSlot);
    });

    let nextSlot = (selectedSlot + 1) % 6;
    highlightSlot(nextSlot);
    
    updateStats();
    updateHash();
  }

  // Remove item from a slot
  function removeItemFromSlot(idx) {
    currentBuild[idx] = null;
    const slotEl = buildSlots[idx];
    const nameEl = slotEl.querySelector('.slot-name');
    const iconWrapper = slotEl.querySelector('.rounded-full');

    iconWrapper.innerHTML = `
      <span class="slot-number group-hover:hidden transition-all">${idx + 1}</span>
      <span class="slot-add hidden group-hover:inline text-brand-blue dark:text-brand-mint transition-all">+</span>
    `;
    nameEl.innerText = t('Trống');
    
    highlightSlot(idx);
    updateStats();
    updateHash();
  }

  // Calculate final stats
  function updateStats() {
    let hp = currentHero.hp;
    let atk = currentHero.atk;
    let ap = currentHero.ap;
    let def = currentHero.def;
    let mdef = currentHero.mdef;
    let aspd = currentHero.aspd;
    let crit = currentHero.crit;
    let speed = currentHero.speed;
    let cdr = 0;

    currentBuild.forEach(item => {
      if (item && item.stats) {
        if (item.stats.hp) hp += item.stats.hp;
        if (item.stats.atk) atk += item.stats.atk;
        if (item.stats.ap) ap += item.stats.ap;
        if (item.stats.def) def += item.stats.def;
        if (item.stats.mdef) mdef += item.stats.mdef;
        if (item.stats.aspd) aspd += item.stats.aspd;
        if (item.stats.crit) crit += item.stats.crit;
        if (item.stats.speed) {
          if (item.cat === 'speed') {
            speed += item.stats.speed;
          } else {
            speed += Math.round(currentHero.speed * (item.stats.speed / 100));
          }
        }
        if (item.stats.cdr) cdr += item.stats.cdr;
      }
    });

    const cdrCap = cdr > 40 ? 40 : cdr;

    const physicalRed = Math.round((def / (def + 600)) * 1000) / 10;
    const magicRed = Math.round((mdef / (mdef + 600)) * 1000) / 10;

    statHp.innerText = hp;
    statCdr.innerText = `${cdrCap}%` + (cdr > 40 ? ` (${t('Vượt')} ${cdr - 40}%)` : '');
    if (cdr > 40) {
      statCdr.classList.add('text-red-500');
    } else {
      statCdr.classList.remove('text-red-500');
    }
    statAtk.innerText = atk;
    statAp.innerText = ap;
    statDef.innerHTML = `${def} <span class="text-xs font-normal text-slate-400">(${physicalRed}% ${t('giảm ST')})</span>`;
    statMdef.innerHTML = `${mdef} <span class="text-xs font-normal text-slate-400">(${magicRed}% ${t('giảm ST')})</span>`;
    statAspd.innerText = `${aspd}%`;
    statCrit.innerText = `${crit}%`;
  }

  // Update hash url
  function updateHash() {
    const itemIds = currentBuild.map(item => item ? item.id : 'null').join(',');
    window.history.replaceState(null, null, `#hero=${currentHero.id}&items=${itemIds}`);
  }

  // Load from hash url
  function loadFromHash() {
    const hash = window.location.hash;
    if (!hash) return;
    
    const params = new URLSearchParams(hash.substring(1));
    const heroId = params.get('hero');
    const itemsStr = params.get('items');

    if (heroId) {
      setHero(heroId);
    }
    if (itemsStr) {
      const ids = itemsStr.split(',');
      ids.forEach((id, idx) => {
        if (id && id !== 'null') {
          const item = ITEMS.find(it => it.id === id);
          if (item) {
            selectedSlot = idx;
            addItemToBuild(item);
          }
        }
      });
      highlightSlot(0);
    }
  }

  // Trigger telemetry increment
  function trackCalculations() {
    try {
      const key = 'calc_real_count_build-do-lien-quan';
      localStorage.setItem(key, parseInt(localStorage.getItem(key) || '0') + 1);
    } catch(e) {}
  }

  // Setup Event Listeners
  heroSelect.addEventListener('change', (e) => {
    setHero(e.target.value);
    updateHash();
    trackCalculations();
  });

  buildSlots.forEach((slot, i) => {
    slot.addEventListener('click', () => {
      highlightSlot(i);
    });
  });

  document.getElementById('btnClearBuild').addEventListener('click', () => {
    currentBuild.forEach((_, i) => {
      removeItemFromSlot(i);
    });
    highlightSlot(0);
  });

