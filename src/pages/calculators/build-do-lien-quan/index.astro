  // Set selected item slot
  function highlightSlot(idx) {
    selectedSlot = idx;
    buildSlots.forEach((slot, i) => {
      if (i === idx) {
        slot.querySelector('.rounded-full').classList.add('ring-4', 'ring-brand-blue', 'dark:ring-brand-mint');
      } else {
        slot.querySelector('.rounded-full').classList.remove('ring-4', 'ring-brand-blue', 'dark:ring-brand-mint');
      }
    });
  }

  // Load items of a category
  function loadItems(category) {
    itemsGrid.innerHTML = '';
    const filtered = ITEMS.filter(item => item.cat === category);
    
    filtered.forEach(item => {
      const card = document.createElement('button');
      card.className = "flex items-center gap-3 p-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-brand-blue dark:hover:border-brand-mint rounded-xl text-left transition select-none group focus:outline-none";
