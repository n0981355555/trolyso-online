    btn.addEventListener('click', (e) => {
      tabBtns.forEach(b => b.className = "item-tab-btn px-4 py-2 text-xs font-bold text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 rounded-t-xl shrink-0");
      e.target.className = "item-tab-btn px-4 py-2 text-xs font-bold rounded-t-xl bg-brand-blue text-white shrink-0";
      loadItems(e.target.dataset.cat);
    });
  });

  document.getElementById('btnShareBuild').addEventListener('click', () => {
    trackCalculations();
    navigator.clipboard.writeText(window.location.href).then(() => {
      alert(isEn ? 'Build link copied successfully! You can send this link to your friends.' : 'Đã sao chép liên kết build đồ thành công! Bạn có thể gửi link này cho bạn bè.');
    }).catch(err => {
      alert(isEn ? 'Cannot copy link. Please copy it directly from address bar.' : 'Không thể sao chép liên kết. Hãy copy đường dẫn trực tiếp trên thanh địa chỉ.');
    });
  });

  document.getElementById('btnSaveBuild').addEventListener('click', () => {
    trackCalculations();
    const canvas = document.getElementById('buildCanvas');
    const ctx = canvas.getContext('2d');

    canvas.width = 600;
    canvas.height = 400;

    const grad = ctx.createLinearGradient(0, 0, 600, 400);
    grad.addColorStop(0, '#1e293b');
    grad.addColorStop(1, '#0f172a');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, 600, 400);

    ctx.strokeStyle = '#38bdf8';
    ctx.lineWidth = 4;
    ctx.strokeRect(10, 10, 580, 380);

    ctx.fillStyle = '#ffffff';
    ctx.font = 'bold 24px Arial';
    ctx.fillText(isEn ? 'ARENA OF VALOR HERO BUILD CARD' : 'THẺ LỐI LÊN ĐỒ LIÊN QUÂN MOBILE', 40, 50);

    ctx.fillStyle = '#94a3b8';
    ctx.font = '14px Arial';
    ctx.fillText(isEn ? 'trolyso.online - Online Calculator Tools' : 'trolyso.online - Công cụ tính toán trực tuyến', 40, 75);

    ctx.fillStyle = '#38bdf8';
    ctx.font = 'bold 20px Arial';
    ctx.fillText(isEn ? `${currentHero.icon} Hero: ${currentHero.name}` : `${currentHero.icon} Vị tướng: ${currentHero.name}`, 40, 120);

    ctx.fillStyle = '#ffffff';
    ctx.font = '14px Arial';
    ctx.fillText(isEn ? `Role: ${t(currentHero.role)}` : `Vai trò: ${currentHero.role}`, 40, 145);

    ctx.fillStyle = '#e2e8f0';
    ctx.font = 'bold 13px Arial';
    ctx.fillText(isEn ? `Max HP: ${statHp.innerText}` : `Máu tối đa: ${statHp.innerText}`, 40, 185);
    ctx.fillText(isEn ? `Physical Attack: ${statAtk.innerText}` : `Công vật lý: ${statAtk.innerText}`, 40, 210);
    ctx.fillText(isEn ? `Magic Attack: ${statAp.innerText}` : `Công phép: ${statAp.innerText}`, 40, 235);
    ctx.fillText(isEn ? `Physical Defense: ${statDef.innerText.split(' ')[0]}` : `Giáp vật lý: ${statDef.innerText.split(' ')[0]}`, 40, 260);
    ctx.fillText(isEn ? `Magic Defense: ${statMdef.innerText.split(' ')[0]}` : `Giáp phép: ${statMdef.innerText.split(' ')[0]}`, 40, 285);
    ctx.fillText(isEn ? `Cooldown Red.: ${statCdr.innerText}` : `Giảm hồi chiêu: ${statCdr.innerText}`, 40, 310);

    ctx.fillStyle = '#ffffff';
    ctx.font = 'bold 16px Arial';
    ctx.fillText(isEn ? 'Selected Items:' : 'Trang bị đã chọn:', 340, 120);

    currentBuild.forEach((item, idx) => {
      const y = 155 + (idx * 35);
      ctx.fillStyle = item ? '#0ea5e9' : '#475569';
      ctx.beginPath();
      ctx.arc(360, y - 5, 12, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#ffffff';
      ctx.font = '14px Arial';
      ctx.fillText(item ? item.icon : '-', 353, y);

      ctx.fillStyle = item ? '#ffffff' : '#94a3b8';
      ctx.font = 'bold 13px Arial';
      ctx.fillText(item ? `${idx + 1}. ${t(item.name)}` : `${idx + 1}. ${isEn ? 'Empty' : 'Trống'}`, 385, y);
    });

    ctx.fillStyle = '#475569';
    ctx.font = 'italic 11px Arial';
    ctx.fillText(isEn ? 'Copyright © 2026 trolyso.online' : 'Bản quyền thuộc về trolyso.online 2026', 40, 360);

    const link = document.createElement('a');
    link.download = `build-do-${currentHero.id}-trolyso.png`;
    link.href = canvas.toDataURL('image/png');
    link.click();
  });

  setHero('arthur');
  highlightSlot(0);
  loadItems('atk');
  loadFromHash();
</script>
